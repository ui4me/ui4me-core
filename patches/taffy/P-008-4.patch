+/// The grid of a container before track sizing: its items (placed, in document order), its tracks (with their
+/// sizing functions) and the line names (steps 2 to 5 of `compute_grid_layout`).
+struct GridBuild<S: CheapCloneStr> {
+    /// The in-flow items, in document order
+    items: Vec<GridItem>,
+    /// The column tracks and gutters
+    columns: GridTrackVec<GridTrack>,
+    /// The row tracks and gutters
+    rows: GridTrackVec<GridTrack>,
+    /// The final column counts (explicit and implicit)
+    final_col_counts: TrackCounts,
+    /// The final row counts (explicit and implicit)
+    final_row_counts: TrackCounts,
+    /// The line name resolver
+    name_resolver: NamedLineResolver<S>,
+    /// The per-line column names of the explicit grid
+    detailed_column_line_names: GridLineNames<S>,
+    /// The per-line row names of the explicit grid
+    detailed_row_line_names: GridLineNames<S>,
+}
+
+/// Resolve the explicit grid, place the items and initialise the tracks of `node` (steps 2 to 5 of
+/// `compute_grid_layout`). `subgrid` is the information the parent grid recorded for a subgrid (ui4me
+/// P-008-4): a subgridded axis has exactly the spanned tracks of the parent, with the given sizes when they are
+/// known, inherits the parent's line names and has no implicit tracks.
+#[allow(clippy::too_many_arguments)]
+fn build_grid<Tree: LayoutGridContainer>(
+    tree: &Tree,
+    node: NodeId,
+    style: &Tree::GridContainerStyle<'_>,
+    auto_fit_container_size: Size<Option<f32>>,
+    auto_repeat_fit_strategy: Size<AutoRepeatStrategy>,
+    align_items: AlignItems,
+    justify_items: AlignItems,
+    subgrid: Option<&subgrid::SubgridInfo<Tree::CustomIdent>>,
+    subgrid_geometry: Option<&subgrid::SubgridGeometry>,
+) -> GridBuild<Tree::CustomIdent> {
+    let sub_columns = subgrid.and_then(|info| info.columns.as_ref());
+    let sub_rows = subgrid.and_then(|info| info.rows.as_ref());
+
+    // Compute the number of rows and columns in the explicit grid *template*
+    // (explicit tracks from grid_areas are computed separately below)
+    let (mut col_auto_repetition_count, mut grid_template_col_count) = compute_explicit_grid_size_in_axis(
+        style,
+        auto_fit_container_size.width,
+        auto_repeat_fit_strategy.width,
+        |val, basis| tree.calc(val, basis),
+        AbsoluteAxis::Horizontal,
+    );
+    let (mut row_auto_repetition_count, mut grid_template_row_count) = compute_explicit_grid_size_in_axis(
+        style,
+        auto_fit_container_size.height,
+        auto_repeat_fit_strategy.height,
+        |val, basis| tree.calc(val, basis),
+        AbsoluteAxis::Vertical,
+    );
+    // ui4me P-008-4: a subgridded axis has exactly the tracks it spans in its parent grid
+    if let Some(info) = sub_columns {
+        col_auto_repetition_count = 0;
+        grid_template_col_count = info.track_count;
+    }
+    if let Some(info) = sub_rows {
+        row_auto_repetition_count = 0;
+        grid_template_row_count = info.track_count;
+    }
+
+    // type CustomIdent<'a> = <<Tree as LayoutPartialTree>::CoreContainerStyle<'_> as CoreStyle>::CustomIdent;
+    let mut name_resolver = NamedLineResolver::new(style, col_auto_repetition_count, row_auto_repetition_count);
+
+    // Clamp the explicit grid to MAX_GRID_TRACKS tracks in each axis
+    // https://www.w3.org/TR/css-grid-1/#overlarge-grids
+    let explicit_col_count = match sub_columns {
+        Some(info) => info.track_count,
+        None => grid_template_col_count.max(name_resolver.area_column_count()).min(MAX_GRID_TRACKS),
+    };
+    let explicit_row_count = match sub_rows {
+        Some(info) => info.track_count,
+        None => grid_template_row_count.max(name_resolver.area_row_count()).min(MAX_GRID_TRACKS),
+    };
+
+    name_resolver.set_explicit_column_count(explicit_col_count);
+    name_resolver.set_explicit_row_count(explicit_row_count);
+
+    // ui4me P-008-4: the line names of a subgridded axis: its own `<line-name-list>` (at most one name set per
+    // line, the excess is ignored) and the names of the parent's spanned lines
+    for (axis, info) in [(AbsoluteAxis::Horizontal, sub_columns), (AbsoluteAxis::Vertical, sub_rows)] {
+        let Some(info) = info else { continue };
+        let own_names = match axis {
+            AbsoluteAxis::Horizontal => style.grid_template_column_names(),
+            AbsoluteAxis::Vertical => style.grid_template_row_names(),
+        };
+        let mut own: Vec<(u32, Tree::CustomIdent)> = Vec::new();
+        if let Some(own_names) = own_names {
+            for (index, line_names) in own_names.enumerate() {
+                if index > info.track_count as usize {
+                    break;
+                }
+                for name in line_names.into_iter() {
+                    own.push((index as u32 + 1, name.clone()));
+                }
+            }
+        }
+        name_resolver.add_subgrid_line_names(axis, &own, true);
+        name_resolver.add_subgrid_line_names(axis, &info.line_names, false);
+    }
+
+    // Build the per-line names of the explicit grid from the name resolver's collected pairs
+    let detailed_column_line_names = name_resolver.detailed_line_names(AbsoluteAxis::Horizontal);
+    let detailed_row_line_names = name_resolver.detailed_line_names(AbsoluteAxis::Vertical);
+
+    // 3. Create the grid items (in document order) and resolve the named lines in their `grid-row`/`grid-column` styles
+    // Absolutely positioned children do not take part in grid placement and do not create implicit tracks,
+    // so they are excluded here. Each child's style is read and its named lines resolved exactly once; the
+    // results drive both the grid size estimate and item placement below.
+    let child_count = tree.child_count(node);
+    let mut items: Vec<GridItem> = Vec::with_capacity(child_count);
+    let mut placements: Vec<ItemPlacement> = Vec::with_capacity(child_count);
+    for (index, child_node) in tree.child_ids(node).enumerate() {
+        let child_style = tree.get_grid_child_style(child_node);
+        if child_style.box_generation_mode() == BoxGenerationMode::None || child_style.position().is_out_of_flow() {
+            continue;
+        }
+        placements.push(InBothAbsAxis {
+            horizontal: name_resolver
+                .resolve_column_names(&child_style.grid_column())
+                .into_origin_zero(explicit_col_count),
+            vertical: name_resolver.resolve_row_names(&child_style.grid_row()).into_origin_zero(explicit_row_count),
+        });
+        // ui4me P-008-4: an in-flow grid item whose tracks are `subgrid` is a subgrid (CSS Grid 2 section 9.1)
+        let subgrid_axes = Size {
+            width: child_style.is_subgrid_item(AbsoluteAxis::Horizontal),
+            height: child_style.is_subgrid_item(AbsoluteAxis::Vertical),
+        };
+        let mut item =
+            GridItem::new_with_style_and_order(child_node, child_style, align_items, justify_items, index as u16);
+        if subgrid_axes.width || subgrid_axes.height {
+            item.mark_subgrid(subgrid_axes);
+        }
+        items.push(item);
+    }
+
+    // ui4me P-008-4: in a subgridded axis, lines outside the subgrid are clamped into it before placement
+    // (so items placed past its last line compete for its last track, as in the reference browser)
+    if let Some(info) = sub_columns {
+        subgrid::clamp_placements_to_subgrid(&mut placements, AbsoluteAxis::Horizontal, info.track_count);
+    }
+    if let Some(info) = sub_rows {
+        subgrid::clamp_placements_to_subgrid(&mut placements, AbsoluteAxis::Vertical, info.track_count);
+    }
+
+    // 4. Implicit Grid: Estimate Track Counts
+    // Estimate the number of rows and columns in the implicit grid (= the entire grid)
+    // This is necessary as part of placement. Doing it early here is a perf optimisation to reduce allocations.
+    let (est_col_counts, est_row_counts) =
+        compute_grid_size_estimate(explicit_col_count, explicit_row_count, &placements);
+
+    // 5. Grid Item Placement
+    // Match items (children) to a definite grid position (row start/end and column start/end position)
+    let mut cell_occupancy_matrix = CellOccupancyMatrix::with_track_counts(est_col_counts, est_row_counts);
+    // `items` is in document order from here on (placement only fills in each item's grid area). The track
+    // sizing and baseline passes sort references to the items rather than the items themselves.
+    place_grid_items(&mut cell_occupancy_matrix, &mut items, &placements, style.grid_auto_flow());
+
+    // Extract track counts from previous step (auto-placement can expand the number of tracks)
+    let mut final_col_counts = *cell_occupancy_matrix.track_counts(AbsoluteAxis::Horizontal);
+    let mut final_row_counts = *cell_occupancy_matrix.track_counts(AbsoluteAxis::Vertical);
+
+    // ui4me P-008-4: a subgridded axis has no implicit tracks: each item's area is clamped to the explicit grid
+    if let Some(info) = sub_columns {
+        subgrid::clamp_items_to_subgrid(&mut items, AbstractAxis::Inline, info.track_count);
+        final_col_counts = TrackCounts::from_raw(0, info.track_count, 0);
+    }
+    if let Some(info) = sub_rows {
+        subgrid::clamp_items_to_subgrid(&mut items, AbstractAxis::Block, info.track_count);
+        final_row_counts = TrackCounts::from_raw(0, info.track_count, 0);
+    }
+
+    // 5. Initialize Tracks
+    // Initialize (explicit and implicit) grid tracks (and gutters)
+    // This resolves the min and max track sizing functions for all tracks and gutters
+    let mut columns = GridTrackVec::new();
+    let mut rows = GridTrackVec::new();
+    match sub_columns {
+        Some(info) => subgrid::initialize_subgrid_tracks(
+            &mut columns,
+            info,
+            subgrid_geometry.and_then(|g| g.track_gap(AbstractAxis::Inline)),
+            subgrid_geometry.map(|g| (g.edges.left, g.edges.right)).unwrap_or((0.0, 0.0)),
+        ),
+        None => initialize_grid_tracks(
+            &mut columns,
+            final_col_counts,
+            style,
+            AbsoluteAxis::Horizontal,
+            col_auto_repetition_count,
+            |column_index| cell_occupancy_matrix.column_is_occupied(column_index),
+        ),
+    }
+    match sub_rows {
+        Some(info) => subgrid::initialize_subgrid_tracks(
+            &mut rows,
+            info,
+            subgrid_geometry.and_then(|g| g.track_gap(AbstractAxis::Block)),
+            subgrid_geometry.map(|g| (g.edges.top, g.edges.bottom)).unwrap_or((0.0, 0.0)),
+        ),
+        None => initialize_grid_tracks(
+            &mut rows,
+            final_row_counts,
+            style,
+            AbsoluteAxis::Vertical,
+            row_auto_repetition_count,
+            |row_index| cell_occupancy_matrix.row_is_occupied(row_index),
+        ),
+    }
+
+    GridBuild {
+        items,
+        columns,
+        rows,
+        final_col_counts,
+        final_row_counts,
+        name_resolver,
+        detailed_column_line_names,
+        detailed_row_line_names,
+    }
+}
