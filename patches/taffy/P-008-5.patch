+/// ui4me patch P-008-5: hand the block-axis runs to the host (`LayoutPartialTree::frag_place_runs`) and apply the
+/// struts it returns. Returns the total strut.
+fn frag_place_runs(
+    tree: &mut impl LayoutFlexboxContainer,
+    node: NodeId,
+    flex_lines: &mut [FlexLine],
+    constants: &AlgoConstants,
+) -> f32 {
+    let mut runs = Vec::new();
+    let mut items = Vec::new();
+    if constants.is_row {
+        let mut y = constants.content_box_inset.top;
+        for (i, line) in flex_lines.iter().enumerate() {
+            let start = y + line.offset_cross;
+            runs.push(crate::FragRun { start, size: line.cross_size });
+            for item in line.items.iter() {
+                items.push(crate::FragRunItem {
+                    node: item.node,
+                    first: i as u32,
+                    last: i as u32,
+                    offset: item.offset_cross + item.margin.top,
+                    size: Some(item.target_size.height),
+                });
+            }
+            y = start + line.cross_size;
+        }
+    } else {
+        let Some(line) = flex_lines.first() else { return 0.0 };
+        let mut y = constants.content_box_inset.top;
+        for (i, item) in line.items.iter().enumerate() {
+            let start = y + item.offset_main;
+            let size = item.margin.top + item.target_size.height + item.margin.bottom;
+            runs.push(crate::FragRun { start, size });
+            items.push(crate::FragRunItem {
+                node: item.node,
+                first: i as u32,
+                last: i as u32,
+                offset: item.margin.top,
+                size: Some(item.target_size.height),
+            });
+            y = start + size;
+        }
+    }
+    let before: Vec<f32> = runs.iter().map(|r| r.start).collect();
+    tree.frag_place_runs(node, &mut runs, &items);
+    let mut prev = 0.0;
+    let mut k = 0;
+    for line in flex_lines.iter_mut() {
+        if constants.is_row {
+            let delta = (runs[k].start - before[k]).max(prev);
+            line.offset_cross += delta - prev;
+            prev = delta;
+            k += 1;
+        } else {
+            for item in line.items.iter_mut() {
+                let delta = (runs[k].start - before[k]).max(prev);
+                item.offset_main += delta - prev;
+                prev = delta;
+                k += 1;
+            }
+        }
+    }
+    prev
+}
