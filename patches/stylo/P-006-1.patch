+fn eval_prefers_reduced_motion(context: &Context, query_value: Option<PrefersReducedMotion>) -> bool {
+    match query_value {
+        Some(v) => context.device().reduced_motion() == v,
+        None => context.device().reduced_motion() == PrefersReducedMotion::Reduce,
+    }
