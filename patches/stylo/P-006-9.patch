--- a/style/properties/properties.mako.rs
+++ b/style/properties/properties.mako.rs
@@ -423,7 +423,13 @@ impl NonCustomPropertyId {
             0,
             % endfor
         ];
-        MAP[self.0 as usize] & rule_types.bits() != 0
+        // ui4me P-006-9: the page context and the page-margin boxes (CSS Paged Media 3 sections 3.2 and 5.3)
+        // take the properties of a box as well as the page descriptors.
+        let mut bits = rule_types.bits();
+        if rule_types.intersects(CssRuleTypes::from_bits(CssRuleType::Page.bit() | CssRuleType::Margin.bit())) {
+            bits |= CssRuleType::Style.bit();
+        }
+        MAP[self.0 as usize] & bits != 0
     }
 
