         if let Some(role_description) = self.braille_role_description() {
             attributes.insert("brailleroledescription", role_description.to_string());
         }
+        // UI4ME: publish the table/tree and live-region metadata the document projection
+        // already carries (Core 1.0 DOC-29/DOC-30). The pinned D-Bus adapter has no Table or
+        // TableCell interface, so cells carry 1-based row/column attributes as browsers do for
+        // ARIA tables; tree items and headings carry their one-based level.
+        let data = self.0.data();
+        if let Some(level) = self.0.level() {
+            // AccessKit levels are zero-based; AT-SPI `level` is one-based like ARIA.
+            attributes.insert("level", (level + 1).to_string());
+        }
+        if let Some(index) = data.row_index() {
+            attributes.insert("rowindex", (index + 1).to_string());
+        }
+        if let Some(index) = data.column_index() {
+            attributes.insert("colindex", (index + 1).to_string());
+        }
+        if let Some(count) = data.row_count() {
+            attributes.insert("rowcount", count.to_string());
+        }
+        if let Some(count) = data.column_count() {
+            attributes.insert("colcount", count.to_string());
+        }
+        if let Some(span) = data.row_span().filter(|span| *span > 1) {
+            attributes.insert("rowspan", span.to_string());
+        }
+        if let Some(span) = data.column_span().filter(|span| *span > 1) {
+            attributes.insert("colspan", span.to_string());
+        }
+        let politeness = |live: Live| match live {
+            Live::Off => "off",
+            Live::Polite => "polite",
+            Live::Assertive => "assertive",
+        };
+        if let Some(live) = data.live() {
+            attributes.insert("live", politeness(live).to_string());
+            if data.is_live_atomic() {
+                attributes.insert("atomic", "true".to_string());
+            }
+        }
+        if data.is_busy() {
+            attributes.insert("busy", "true".to_string());
+        }
+        let mut container = Some(*self.0);
+        while let Some(node) = container {
+            if let Some(live) = node.data().live() {
+                attributes.insert("container-live", politeness(live).to_string());
+                if node.data().is_live_atomic() {
+                    attributes.insert("container-atomic", "true".to_string());
+                }
+                if node.data().is_busy() {
+                    attributes.insert("container-busy", "true".to_string());
+                }
+                break;
+            }
+            container = node.parent();
+        }
 
         attributes
     }
