#!/bin/bash
# wj NAME TIMEOUT_SECONDS [APARTMENT] < body.ps1 : run body as ui4me_test in its RDP session (hidden console)
set -e
NAME=$1; TO=${2:-600}; AP=${3:-STA}
L=$(dirname "$0"); mkdir -p $L/jobs
{ printf '\xef\xbb\xbf'; cat <<HDR
\$ErrorActionPreference = 'Continue'
\$ProgressPreference = 'SilentlyContinue'
Set-Location F:\\ui4me\\src
\$env:PATH = "C:\\Program Files\\Python313;C:\\Program Files\\Python313\\Scripts;\$env:USERPROFILE\\.cargo\\bin;\$env:PATH"
\$env:CARGO_BUILD_JOBS = '2'
Start-Transcript -Path F:\\ui4me\\jobs\\$NAME.log -Force | Out-Null
"session=" + (Get-Process -Id \$PID).SessionId + " user=" + [Environment]::UserName
\$global:jobrc = 0
try {
HDR
cat
cat <<'FTR'
} catch { "JOB ERROR: $_"; $global:jobrc = 1 } finally { Stop-Transcript | Out-Null }
exit $global:jobrc
FTR
} > $L/jobs/$NAME.ps1
scp -q -o BatchMode=yes $L/jobs/$NAME.ps1 "administrator@omegaui:F:/ui4me/jobs/$NAME.ps1"
set +e
ssh -o BatchMode=yes -o ServerAliveInterval=30 administrator@omegaui "pwsh -NoProfile -File F:\\ui4me\\start_interactive.ps1 -UserName ui4me_test -ScriptPath F:\\ui4me\\jobs\\$NAME.ps1 -TimeoutSeconds $TO -Apartment $AP -Hidden" 2>&1 | tail -2
rc=${PIPESTATUS[0]}
ssh -o BatchMode=yes administrator@omegaui "type F:\\ui4me\\jobs\\$NAME.log" 2>/dev/null | grep -v '^\*\*\*\*\|^Windows PowerShell transcript\|^Start time\|^End time\|^Username\|^RunAs\|^Configuration\|^Machine\|^Host Application\|^Process ID\|^PSVersion\|^PSEdition\|^PSCompatible\|^BuildVersion\|^CLRVersion\|^WSManStack\|^PSRemoting\|^SerializationVersion\|^Transcript started' | tr -d '\r'
exit $rc
